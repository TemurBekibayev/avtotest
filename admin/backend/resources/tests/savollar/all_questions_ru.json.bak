                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какова должна быть минимальная остаточная глубина рисунка протектора шин мотоцикла?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 175069,
                                "newtest_question_id": 8544,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "0,5 мм"
                                    }
                                ],
                                "check": 0
                            },
