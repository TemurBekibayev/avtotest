                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В этой ситуации вы едете по правой полосе, должны ли вы уступить дорогу транспортному средству, перестраивающемуся на вашу полосу?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11375/11375-1-267.jpg"
