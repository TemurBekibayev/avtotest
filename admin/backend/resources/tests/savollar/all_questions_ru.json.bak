                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "На задней стенке кузовы автотранспортных средств категории N2; N3; O3; O4; M2; M3 (кроме особо малых) должен быть нанесен:"
                            }
                        ],
                        "answers": [
                            {
                                "id": 170258,
                                "newtest_question_id": 11178,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Опознавательных знак о принадлежности транспортного средства"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 170259,
