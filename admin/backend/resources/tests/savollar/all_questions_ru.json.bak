                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "На каком порядке разрешается ставить транспортные средства не имеющих местное уширение проезжей части?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10402/10402-1-818.jpg"
