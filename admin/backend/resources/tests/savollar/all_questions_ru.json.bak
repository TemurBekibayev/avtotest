                    {
                        "id": 7573,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Водителю какого автомобиля разрешена остановка?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7573/7573-1-924.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 188944,
                                "newtest_question_id": 7573,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Водителю легкового автомобиля."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 188945,
                                "newtest_question_id": 7573,
