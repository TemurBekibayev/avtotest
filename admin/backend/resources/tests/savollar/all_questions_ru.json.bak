                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "На каком рисунке изображен автомобиль, водитель которого нарушает правила перевозки грузов?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10257/10257-1-878.jpg"
