                    {
                        "id": 11774,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какой из следующих знаков отменяет действие знака 3.24 «Ограничение максимальной скорости»?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11774/11774-1.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 185251,
                                "newtest_question_id": 11774,
                                "body": [
                                    {
                                        "order": 1,
