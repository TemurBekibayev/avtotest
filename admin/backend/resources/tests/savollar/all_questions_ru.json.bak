                                "order": 1,
                                "type": 1,
                                "value": "Кто из водителей нарушает правила?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11657/11657-1-283.jpg"
                            }
