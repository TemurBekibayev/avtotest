                    {
                        "id": 10938,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каких местах запрещено движение задним ходом?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 169358,
                                "newtest_question_id": 10938,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На перекрестках, пешеходных переходах"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 169359,
                                "newtest_question_id": 10938,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На мостах, путепроводах, эстакадах и под ними"
