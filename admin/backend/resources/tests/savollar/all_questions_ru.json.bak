        "data": {
            "status": 1,
            "data": {
                "questions": [
                    {
                        "id": 6107,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Зависит ли выбор бокового интервала от скорости движения?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 149730,
                                "newtest_question_id": 6107,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Выбор бокового интервала не зависит от скорости движения."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 149731,
                                "newtest_question_id": 6107,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "При увеличении скорости движения необходимо увеличить боковой интервал ."
                                    }
                                ],
                                "check": 1
                            }
                        ],
                        "answer_description": "При увеличении скорости увеличиваются и поперечные отклонения от задаваемой водителем траектории движения. Это происходит за счет боковой эластичности колес, неровностей покрытия, воздействия ветра и люфтов в механизмах рулевого управления. Поэтому, увеличивая скорость, водители должны увеличивать боковой интервал.",
                        "answer_video": null,
                        "comment": null,
                        "static_order_answers": 1,
                        "is_new": false,
                        "newtest_lesson_id": 11,
                        "status": 1,
