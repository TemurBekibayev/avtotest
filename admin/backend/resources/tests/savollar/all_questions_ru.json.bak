                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каких случаях, автомобили обозначаются таким опознавательным знаком?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8511/8511-1-690.jpg"
                            }
                        ],
                        "answers": [
