                    {
                        "id": 6919,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Каким транспортным средствам разрешается движение в указанных направлениях?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6919/6919-1-850.jpg"
