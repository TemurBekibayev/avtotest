                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какой автомобиль нарушил правила остановки?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10980/10980-1-176.jpg"
