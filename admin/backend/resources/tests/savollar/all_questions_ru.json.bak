                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Лица, уполномоченные регулировать дорожное движение, должны иметь при себе:"
                            }
                        ],
                        "answers": [
                            {
                                "id": 175831,
                                "newtest_question_id": 6232,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Соответствующее удостоверение и отличительный знак – нарукавная повязка"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 175832,
                                "newtest_question_id": 6232,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Жезл"
