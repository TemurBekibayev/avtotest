                    {
                        "id": 8821,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Как нужно транспортировать раненного с повреждением грудной клетки?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8821/8821-1-200.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 183817,
                                "newtest_question_id": 8821,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "В положении лежа на поврежденном боку или полусидя."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 183818,
