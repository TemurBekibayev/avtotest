                            {
                                "order": 1,
                                "type": 1,
                                "value": "При данном сигнале регулировщика каким транспортным средствам разрешается движение?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/12094/12094-1.jpg"
                            }
                        ],
