                    {
                        "id": 8121,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Транспортные средства проедут перекресток в следующем порядке:"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8121/8121-1-144.jpg"
                            }
                        ],
                        "answers": [
