                                "id": 189608,
                                "newtest_question_id": 10218,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Левого поворота или разворота"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 189609,
                                "newtest_question_id": 10218,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Правого поворота или разворота"
                                    }
                                ],
                                "check": 0
                            },
                            {
