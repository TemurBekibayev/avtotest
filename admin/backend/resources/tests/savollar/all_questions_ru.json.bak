                            {
                                "order": 1,
                                "type": 1,
                                "value": "По каким направлениям разрешено движение грузовому автомобилю?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11940/11940-1-458.jpg"
