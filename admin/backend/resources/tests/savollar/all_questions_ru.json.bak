                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Каким видом транспорта следует перевозить пострадавшего с черепно–мозговой травмой средней тяжести?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8818/8818-1-216.jpg"
                            }
                        ],
                        "answers": [
