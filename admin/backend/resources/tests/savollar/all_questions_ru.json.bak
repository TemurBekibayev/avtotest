                    {
                        "id": 8623,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Как правильно произвести экстренное торможение, если автомобиль оборудован антиблокировочной тормозной системой (ABS)?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8623/8623-1-630.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 184300,
                                "newtest_question_id": 8623,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Путем прерывистого нажатия на педаль тормоза."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 184301,
                                "newtest_question_id": 8623,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Путем нажатия на педаль тормоза до упора и удерживания ее до полной остановки."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 184302,
                                "newtest_question_id": 8623,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Путем использования стояночной тормозной системы."
                                    }
                                ],
                                "check": 0
                            }
                        ],
                        "answer_description": "При наличии на автомобиле антиблокировочной тормозной системы, контроль над сцеплением шины с покрытием проезжей части возложен на эту систему. Поэтому при экстренном торможении следует нажать на педаль тормоза до отказа и удерживать ее до полной остановки.",
                        "answer_video": null,
                        "comment": null,
                        "static_order_answers": 1,
                        "is_new": false,
                        "newtest_lesson_id": 11,
                        "status": 1,
