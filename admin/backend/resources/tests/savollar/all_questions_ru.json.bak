                                        "value": "На самой обочине"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 175140,
                                "newtest_question_id": 7537,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На проезжей части, на расстоянии 0,5 м от обочины"
