                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каких направлениях разрешено продолжить движение на перекрестке?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6739/6739-1-199.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 183685,
                                "newtest_question_id": 6739,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Только D и F."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 183686,
                                "newtest_question_id": 6739,
                                "body": [
