                    {
                        "id": 10854,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какие из этих знаков являются временными дорожными знаками?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10854/10854-1-646.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 169042,
                                "newtest_question_id": 10854,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "1 и 4"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 169043,
                                "newtest_question_id": 10854,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "2 и 3"
                                    }
