                            {
                                "order": 1,
                                "type": 1,
                                "value": "Вы намерены повернуть налево. Кому следует уступить дорогу?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10428/10428-1-649.jpg"
