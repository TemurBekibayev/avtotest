                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каком ответе полностью указаны места посадки и высадки пассажиров в условиях, где нет специальных площадок для посадки и высадки?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 174802,
                                "newtest_question_id": 6259,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Со стороны проезжей части или тротуара"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 174803,
                                "newtest_question_id": 6259,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Со стороны тротуара"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 174804,
                                "newtest_question_id": 6259,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Со стороны обочины или проезжей части"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 174805,
                                "newtest_question_id": 6259,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Со стороны тротуара или обочины"
                                    }
                                ],
                                "check": 1
                            }
                        ],
                        "answer_description": "Согласно абзацу 1 пункта 23 главы 5 ПДД, пассажиры обязаны производить посадку и высадку со стороны тротуара или обочины и только после полной остановки транспортного средства.",
