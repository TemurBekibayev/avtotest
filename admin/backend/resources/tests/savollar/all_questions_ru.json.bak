                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли буксировка мотоцикла с боковым прицепом по дороге, на которой установлен этот знак?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10935/10935-1.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 169346,
                                "newtest_question_id": 10935,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Допускается использование не более одного мотоцикла с прицепом"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 169347,
                                "newtest_question_id": 10935,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Разрешается только на жесткой сцепке"
                                    }
                                ],
                                "check": 0
