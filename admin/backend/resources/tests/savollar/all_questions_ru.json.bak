                        "id": 8502,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какой из указанных знаков устанавливается для обозначения автопоезда?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8502/8502-1-639.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 183839,
                                "newtest_question_id": 8502,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Левый знак."
                                    }
                                ],
                                "check": 0
