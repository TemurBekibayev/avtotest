                        "id": 10598,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "На каком уклоне запрещается эксплуатация автотранспортных средств категории N, с полной нагрузкой при необеспечении неподвижное состояние стояночной тормозной системы?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10598/10598-1-990.jpg"
                            }
                        ],
                        "answers": [
