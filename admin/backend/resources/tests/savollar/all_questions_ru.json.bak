                        "answers": [
                            {
                                "id": 189825,
                                "newtest_question_id": 11657,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Водители грузового автомобиля с разрешенной максимальной массой 3т и мопеда"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 189826,
                                "newtest_question_id": 11657,
                                "body": [
