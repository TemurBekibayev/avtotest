                    {
                        "id": 7456,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "С какой скоростью вне населенных пунктах разрешается движение транспортным средствам, перевозящим опасные, тяжеловесные и крупногабаритные грузы, а также движущимся в составе организованной колонны ?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 137807,
                                "newtest_question_id": 7456,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Не более 40 км/час."
                                    }
                                ],
                                "check": 0
                            },
