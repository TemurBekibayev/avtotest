                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какие транспортные средства допускается ставить в два ряда на проезжей части?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 138189,
                                "newtest_question_id": 7558,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Двухколесные транспортные средства без бокового прицепа."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 138190,
                                "newtest_question_id": 7558,
