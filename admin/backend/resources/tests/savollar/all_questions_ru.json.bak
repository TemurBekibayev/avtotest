                        "answers": [
                            {
                                "id": 170597,
                                "newtest_question_id": 11268,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Вблизи опасных поворотов и выпуклых переломов продольного профиля дороги с видимостью дороги менее 100 м в одном направлении"
                                    }
                                ],
                                "check": 0
                            },
