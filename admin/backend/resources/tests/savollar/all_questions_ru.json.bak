                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каком случае устойчивость автомобиля повышается против опрокидывания ?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8582/8582-1-460.jpg"
