                    {
                        "id": 11531,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Следующим лицам разрешается не пристёгиваться ремнями безопасности в транспортных средствах, предусмотренных конструкцией ремней безопасности?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 177499,
                                "newtest_question_id": 11531,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Детям до 12 лет на заднем сиденье автомобиля"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 177500,
                                "newtest_question_id": 11531,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Беременным женщинам"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 177501,
                                "newtest_question_id": 11531,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Водителям, едущим задним ходом"
                                    }
                                ],
                                "check": 0
                            },
                            {
