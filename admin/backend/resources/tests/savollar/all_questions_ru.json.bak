                    {
                        "id": 6991,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Каким транспортным средствам разрешено движение?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6991/6991-1-125.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 188057,
                                "newtest_question_id": 6991,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Легковому и грузовому автомобилям"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 188058,
