                        "id": 7654,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешено ли водителю легкового автомобиля совершить манёвр, двигаясь по обозначенным траекториям?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7654/7654-1-410.jpg"
                            }
                        ],
                        "answers": [
