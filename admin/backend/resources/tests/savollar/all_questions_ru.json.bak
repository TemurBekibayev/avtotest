                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Зеленый автомобиль одновременно с желтым."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 188087,
                                "newtest_question_id": 7941,
                                "body": [
                                    {
                                        "order": 1,
