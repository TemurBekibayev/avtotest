                    {
                        "id": 10065,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какой из указанных знаков требует обязательной остановки на нерегулируемых перекрестках?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10065/10065-1.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 164203,
                                "newtest_question_id": 10065,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Только А"
                                    }
                                ],
                                "check": 0
