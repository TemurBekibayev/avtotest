                            {
                                "order": 1,
                                "type": 1,
                                "value": "Водителю какого транспортного средства разрешено движение со скоростью, указанной на знаке?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7444/7444-1-796.jpg"
