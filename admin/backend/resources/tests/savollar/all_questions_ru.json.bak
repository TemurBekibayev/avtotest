                    {
                        "id": 7537,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Где водитель должен остановить транспортное средство при наличии обочины на дороге?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 175139,
                                "newtest_question_id": 7537,
                                "body": [
                                    {
                                        "order": 1,
