                    {
                        "id": 7519,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каких случаях обгон запрещается?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 138057,
                                "newtest_question_id": 7519,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На железнодорожных переездах и ближе чем за 100 метр перед ними."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 138058,
                                "newtest_question_id": 7519,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На железнодорожных переездах и более 100 метров перед ними."
                                    }
                                ],
                                "check": 0
                            },
