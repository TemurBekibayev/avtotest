                    {
                        "id": 11412,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "При наличии каких знаков водитель пользуется преимуществом, если встречный разъезд затруднен препятствием?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11412/11412-1.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 171106,
                                "newtest_question_id": 11412,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "«А» и «C»"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 171107,
                                "newtest_question_id": 11412,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "«B» и «D»"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 171108,
                                "newtest_question_id": 11412,
