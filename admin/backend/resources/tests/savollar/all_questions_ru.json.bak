                    {
                        "id": 6627,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какое место является самым безопасным для расположения детской удерживающей системы в автомобиле?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6627/6627-1.jpg"
