                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "В местах, где движение транспорта мешает движению пешеходов"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 170580,
                                "newtest_question_id": 11262,
                                "body": [
                                    {
                                        "order": 1,
