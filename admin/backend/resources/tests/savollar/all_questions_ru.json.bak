                    {
                        "id": 10811,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Как влияет торможение “юзом” на тормозной путь при сухом состояние дороги?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 168538,
                                "newtest_question_id": 10811,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Тормозной путь уменьшается"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 168539,
                                "newtest_question_id": 10811,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Тормозной путь не изменяется"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 168540,
                                "newtest_question_id": 10811,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Тормозной путь увеличивается"
                                    }
                                ],
                                "check": 1
                            }
                        ],
                        "answer_description": "Уменьшение тормозного пути достигается торможением на грани блокировки, так как заблокированные колеса (торможение «юзом») скользят по дороге, увеличивая при этом тормозной путь.",
