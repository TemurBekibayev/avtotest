                        "id": 10191,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какому транспортному средству движение запрещено?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10191/10191-1-966.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 189727,
                                "newtest_question_id": 10191,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Мотоциклу"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 189728,
                                "newtest_question_id": 10191,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Никому незапрещено"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 189729,
                                "newtest_question_id": 10191,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Грузовому автомобилю"
                                    }
                                ],
                                "check": 1
                            }
                        ],
                        "answer_description": "Согласно пункту 38 Правил дорожного движения, Сигналы регулировщика имеют следующие значения: правая рука вытянута вперед: со стороны левого бока — разрешено движение трамваю налево, безрельсовым транспортным средствам — во всех направлениях; со стороны груди — всем транспортным средствам разрешено движение только направо; со стороны правого бока и спины — движение всех транспортных средств запрещено; пешеходам разрешено переходить проезжую часть за спиной регулировщика.\r\nВ этой ситуации движение запрещено грузовому автомобилю.",
                        "answer_video": "/test_files/testanswer/newtest_questions/10191/10191-872.mp4",
                        "comment": null,
                        "static_order_answers": 0,
                        "is_new": false,
