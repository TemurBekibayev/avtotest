                    {
                        "id": 8694,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Что понимается под остановочным путем?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 175090,
                                "newtest_question_id": 8694,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Расстояние, пройденное автомобилем с момента, когда водитель заметил опасность, до начала торможения"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 175091,
                                "newtest_question_id": 8694,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Расстояние, пройденное автомобилем с момента, когда водитель заметил опасность, до полной остановки"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 175092,
                                "newtest_question_id": 8694,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Расстояние, пройденное транспортным средством с момента срабатывания тормозной системы до полной остановки"
                                    }
                                ],
                                "check": 0
                            }
                        ],
                        "answer_description": "Под остановочным путем понимается расстояние, пройденное транспортным средством с момента обнаружения водителем опасности до полной остановки. Остановочный путь всегда больше тормозного, так как до начала торможения транспортного средства успевает переместиться на расстояние, зависящее от времени реакции водителя и времени срабатывания тормозного привода.",
                        "answer_video": null,
                        "comment": null,
                        "static_order_answers": 1,
                        "is_new": false,
                        "newtest_lesson_id": 11,
                        "status": 1,
