                        "id": 11235,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли водителю управлять транспортным средством под воздействием лекарственных препаратов, снижающих скорость реакции и внимение?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 170492,
                                "newtest_question_id": 11235,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Запрещается"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 170493,
                                "newtest_question_id": 11235,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Разрешается"
                                    }
                                ],
                                "check": 0
