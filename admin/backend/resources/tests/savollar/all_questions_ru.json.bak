                    {
                        "id": 8508,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Каким опознавательным знаком обозначается транспортное средство при перевозке группы детей?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8508/8508-1.png"
                            }
                        ],
                        "answers": [
                            {
                                "id": 147257,
                                "newtest_question_id": 8508,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "A."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 147258,
                                "newtest_question_id": 8508,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "B."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 147259,
                                "newtest_question_id": 8508,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "C."
                                    }
                                ],
                                "check": 1
                            }
                        ],
                        "answer_description": "Согласно определению 3, данному в пункте 176 главы 29 ПДД, «Перевозка группы детей» — знак в виде квадрата желтого цвета с каймой красного цвета и с черным изображением символа дорожного знака 1.21 устанавливается спереди и сзади транспортного средства при организованной перевозке группы детей. Сторона квадратного знака должна быть от 250 до 300 мм, а ширина каймы — 1/10 стороны.",
                        "answer_video": null,
                        "comment": null,
                        "static_order_answers": 1,
                        "is_new": false,
                        "newtest_lesson_id": 25,
