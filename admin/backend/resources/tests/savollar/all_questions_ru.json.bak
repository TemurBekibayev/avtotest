                        "id": 12001,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Сколько полос движения имеется на проезжей части, по которой движутся автомобили?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/12001/12001-1.jpg"
                            }
                        ],
