                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Транспортные средства проедут перекресток в следующем порядке:"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7989/7989-1-155.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 188794,
                                "newtest_question_id": 7989,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Трамвай, автомобиль и автобус одновременно."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 188795,
                                "newtest_question_id": 7989,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Трамвай, автобус, автомобиль."
                                    }
