                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешено ли пересекать сплошную белую линию разметки, обозначающую край проезжей части на автомагистрали?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7638/7638-1-502.jpg"
                            }
                        ],
                        "answers": [
