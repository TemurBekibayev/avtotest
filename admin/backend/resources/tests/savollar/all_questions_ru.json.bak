                            {
                                "order": 1,
                                "type": 1,
                                "value": "Каким документом разрешается управлять механическим транспортным средством, если у владельца при себе отсутствует водительское удостоверение?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 191660,
                                "newtest_question_id": 12064,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "ID-карта"
                                    }
                                ],
                                "check": 0
                            },
