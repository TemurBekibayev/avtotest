                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Белый автомобиль одновременно с желтым."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 188097,
                                "newtest_question_id": 7959,
