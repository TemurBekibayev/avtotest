                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какие опасные последствия может вызвать резкое открытие дроссельной заслонки на скользкой дороге?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 168370,
