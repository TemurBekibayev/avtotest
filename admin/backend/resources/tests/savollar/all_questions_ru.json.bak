                            {
                                "id": 147004,
                                "newtest_question_id": 8640,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Не менять траектории и скорости движения."
                                    }
                                ],
                                "check": 1
