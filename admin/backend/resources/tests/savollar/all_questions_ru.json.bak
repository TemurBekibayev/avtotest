                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Вы намерены повернуть налево. Кому следует уступить дорогу?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10434/10434-1-376.jpg"
                            }
