                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Каковы типичные признаки наступившего утомления водителя?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10296/10296-1-319.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 189233,
                                "newtest_question_id": 10296,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Сонливость, вялость, притупление внимания"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 189234,
                                "newtest_question_id": 10296,
