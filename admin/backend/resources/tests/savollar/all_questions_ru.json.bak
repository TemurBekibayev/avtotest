                    {
                        "id": 6922,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каком ответе названы все транспортные средства, которым разрешено движение?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6922/6922-1-925.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 188957,
                                "newtest_question_id": 6922,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Трамвай и мотоцикл."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 188958,
                                "newtest_question_id": 6922,
