                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "При каком сигнале светофора безрельсовым транспортным средствам, поворачивающим направо на перекрёстках, разрешается движение при наличии данного дорожного знака?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/12058/12058-1.jpg"
                            }
                        ],
                        "answers": [
