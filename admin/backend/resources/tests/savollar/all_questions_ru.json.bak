                                "id": 147841,
                                "newtest_question_id": 8845,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Одежду начинать снимать со здоровой руки, затем освобождать больную руку."
                                    }
                                ],
                                "check": 1
                            }
                        ],
