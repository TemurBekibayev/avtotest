                                "order": 1,
                                "type": 1,
                                "value": "Какой автомобиль правильно поставлен на стоянку?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7585/7585-1-368.jpg"
                            }
