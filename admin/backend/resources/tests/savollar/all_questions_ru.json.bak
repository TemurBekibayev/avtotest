                        "answers": [
                            {
                                "id": 188893,
                                "newtest_question_id": 6601,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Запрещается, потому что расстояние между автомобилем и прерывистой линией дороги меньше 3-х метров."
                                    }
                                ],
                                "check": 0
                            },
