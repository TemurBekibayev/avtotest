                    {
                        "id": 11124,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Где разрешается длительная стоянка транспортных средств (отдых, ночлег и т.д.) вне населенного пункта?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 170068,
                                "newtest_question_id": 11124,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На обочине дороги"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 170069,
                                "newtest_question_id": 11124,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На площадках для стоянки или за пределами дороги"
