                    {
                        "id": 8472,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какое расстояние должно быть обеспечено при буксировке, между буксирующим и буксируемым транспортными средствами?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8472/8472-1-738.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 184057,
                                "newtest_question_id": 8472,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На жесткой сцепке не более 4 метров, а на гибкой сцепке в пределах 4 – 6 метров."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 184058,
                                "newtest_question_id": 8472,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На жесткой сцепке не более 5 метров, а на гибкой сцепке в пределах 6 – 8 метров."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 184059,
                                "newtest_question_id": 8472,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На жесткой сцепке не более 4 метров, а на гибкой сцепке в пределах 7 – 8 метров."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 184060,
                                "newtest_question_id": 8472,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "На жесткой сцепке не более 5 метров, а на гибкой сцепке в пределах 4 – 6 метров."
                                    }
                                ],
                                "check": 0
                            }
                        ],
                        "answer_description": "Согласно пункту 144 главы 24 ПДД, при буксировке на гибкой сцепке расстояние между буксирующим и буксируемым транспортными средствами должно быть в пределах 4 — 6 метров, а при буксировке на жесткой сцепке расстояние между буксирующим и буксируемым транспортными средствами должно быть не более 4 метров.",
                        "answer_video": null,
                        "comment": null,
                        "static_order_answers": 1,
                        "is_new": false,
                        "newtest_lesson_id": 25,
                        "status": 1,
