                                "newtest_question_id": 7129,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Разрешено, если это не ослепляет других водителей, включая через зеркало заднего вида"
                                    }
                                ],
                                "check": 1
                            },
