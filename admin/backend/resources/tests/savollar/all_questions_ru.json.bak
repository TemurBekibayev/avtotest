                            {
                                "order": 1,
                                "type": 1,
                                "value": "Можно ли пользоваться дальним светом фар в качестве предупредительного сигнала при обгоне?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7129/7129-1-312.jpg"
