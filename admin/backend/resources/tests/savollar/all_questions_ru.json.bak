                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Если сила тяги на колесах будет превышать силу сцепления колес с дорогой, то:"
                            }
                        ],
                        "answers": [
                            {
                                "id": 171904,
                                "newtest_question_id": 10654,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Двигатель заглохнет"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 171905,
                                "newtest_question_id": 10654,
                                "body": [
                                    {
                                        "order": 1,
