                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Жёсткая сцепка должна обеспечивать расстояние между транспортными средствами не более какого значения?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10490/10490-1-352.jpg"
                            }
                        ],
                        "answers": [
