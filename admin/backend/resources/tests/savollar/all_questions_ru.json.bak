                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "К вам приближается транспортное средство, на котором включен проблесковый маячок синего цвета и специальный звуковой сигнал. Как вы должны поступить, если двигаетесь навстречу такому транспортному средству?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 172145,
                                "newtest_question_id": 10778,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Остановиться на обочине или у тротуара"
                                    }
                                ],
                                "check": 0
                            },
