                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "По какой траектории двигается прицеп легкового автомобиля при прохождении поворота?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 166061,
                                "newtest_question_id": 10344,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Дальше от центра поворота, чем траектория движения автомобиля"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 166062,
                                "newtest_question_id": 10344,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "По траектории движения автомобиля"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 166063,
                                "newtest_question_id": 10344,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Ближе к центру поворота, чем траектория движения автомобиля"
                                    }
                                ],
                                "check": 1
                            }
                        ],
                        "answer_description": "Согласно требованиям безопасности дорожного движения, автомобильный прицеп движется внутри траектории движения автомобиля относительно центра поворота.",
