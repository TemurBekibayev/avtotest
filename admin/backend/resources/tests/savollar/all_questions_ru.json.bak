                    {
                        "id": 7636,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли использовать для движения посадочную площадку, обозначенную разметкой?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7636/7636-1-186.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 188907,
                                "newtest_question_id": 7636,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Разрешается."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 188908,
                                "newtest_question_id": 7636,
                                "body": [
                                    {
                                        "order": 1,
