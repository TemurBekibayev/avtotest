                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Что означает жест вытягивания левой руки в сторону или поднятия правой руки под прямым углом в локте?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10218/10218-1-413.jpg"
                            }
                        ],
                        "answers": [
