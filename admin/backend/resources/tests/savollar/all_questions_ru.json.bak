                            {
                                "order": 1,
                                "type": 1,
                                "value": "Что должен учитывать водитель при выборе скорости движения?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 148912,
                                "newtest_question_id": 7399,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Интенсивность движения, особенности и состояние транспортного средства и груза."
