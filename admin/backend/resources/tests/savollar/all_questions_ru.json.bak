                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли перевозить детей, не достигших 12 летнего возраста, на переднем сиденье транспортного средства?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 172178,
                                "newtest_question_id": 10796,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Допускается, если установлено специальное устройство, удерживающее детей"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 172179,
                                "newtest_question_id": 10796,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Разрешается только в сопровождении взрослого пассажира"
                                    }
                                ],
                                "check": 0
                            },
                            {
