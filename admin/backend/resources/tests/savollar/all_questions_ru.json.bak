                                "order": 1,
                                "type": 1,
                                "value": "В каком из следующих ответов приведено правильное определение термина «Опасность»?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 169508,
                                "newtest_question_id": 10987,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Любой фактор, угрожающий безопасности дорожного движения"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 169509,
                                "newtest_question_id": 10987,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Любое препятствие, заставляющее участников дорожного движения менять направление движения"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 169510,
                                "newtest_question_id": 10987,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Продолжение движения в том же направлении и с той же скоростью, что и процесс дорожного движения, является фактором, угрожающим дорожно-транспортному происшествию."
                                    }
                                ],
                                "check": 0
                            }
                        ],
                        "answer_description": "ПДД Общие положения: Опасность - это любой фактор, который ставит под угрозу безопасность дорожного движения.",
