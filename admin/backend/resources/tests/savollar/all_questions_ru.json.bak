                    {
                        "id": 8643,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "На повороте возник занос задней оси переднеприводного автомобиля. Ваши действия?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 147012,
                                "newtest_question_id": 8643,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Уменьшите подачу топлива, рулевым колесом стабилизируете движение."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 147013,
                                "newtest_question_id": 8643,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Притормозите и повернете рулевое колесо в сторону заноса."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 147014,
                                "newtest_question_id": 8643,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Слегка увеличите подачу топлива, корректируя направление движения рулевым колесом."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 147015,
                                "newtest_question_id": 8643,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Значительно увеличите подачу топлива, не меняя положения рулевого колеса."
                                    }
                                ],
                                "check": 0
                            }
                        ],
                        "answer_description": "Занос переднеприводного автомобиля может возникнуть при торможении на повороте из-за \"набегание\" задних колес на передние. В этом случае целесообразно слегка увеличить подачу топлива (не вызывая пробуксовки передних колес) и дальнейшим поворотом рулевого колеса скорректировать направление движения автомобиля.",
                        "answer_video": null,
                        "comment": null,
                        "static_order_answers": 1,
                        "is_new": false,
                        "newtest_lesson_id": 11,
