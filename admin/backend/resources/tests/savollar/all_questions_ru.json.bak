                    {
                        "id": 8143,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каком ответе правильно указана последовательность действий водителя автомобиля?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8143/8143-1-767.jpg"
                            }
