                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "При выборе скорости движения водителю запрещается?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 170705,
                                "newtest_question_id": 11299,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Превышать скорость, указанную на опозновательном знаке, установленном на транспортном средстве в соответсвии с настоящими правилами"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 170706,
                                "newtest_question_id": 11299,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Резко тормозить, если это не требуется для обеспечения безопасности движения"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 170707,
