                    {
                        "id": 7962,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Автомобили проедут перекресток в следующем порядке:"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7962/7962-1-803.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 189048,
                                "newtest_question_id": 7962,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Синий, зеленый, красный."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 189049,
                                "newtest_question_id": 7962,
                                "body": [
                                    {
                                        "order": 1,
