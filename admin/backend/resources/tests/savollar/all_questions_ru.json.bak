                            {
                                "order": 1,
                                "type": 1,
                                "value": "Где могут двигаться пешеходы в жилой зоне?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 170426,
                                "newtest_question_id": 11214,
                                "body": [
                                    {
                                        "order": 1,
