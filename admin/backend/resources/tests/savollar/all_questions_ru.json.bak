                    {
                        "id": 11747,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "На каком изображении организованная группа пешеходов движется по проезжей части, не нарушая правила?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11747/11747-1-398.jpg"
                            }
                        ],
                        "answers": [
