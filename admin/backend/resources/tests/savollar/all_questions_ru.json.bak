                        "id": 10326,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В каком случае легковой автомобиль более устойчив против опрокидывания на повороте?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 165971,
                                "newtest_question_id": 10326,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Без груза и пассажиров"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 165972,
                                "newtest_question_id": 10326,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "С пассажирами, но без груза"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 165973,
                                "newtest_question_id": 10326,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Без пассажиров, но с грузом на верхнембагажнике"
                                    }
                                ],
                                "check": 0
                            }
                        ],
                        "answer_description": "Согласно требованиям безопасности дорожного движения, автомобиль без груза и пассажиров более устойчив к опрокидыванию за счет того, что на поворотных участках дороги центр тяжести находится ниже.",
