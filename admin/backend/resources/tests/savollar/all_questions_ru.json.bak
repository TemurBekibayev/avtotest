                                "type": 1,
                                "value": "Таким опознавательным знаком обозначается транспортное средство:"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8517/8517-1-119.jpg"
