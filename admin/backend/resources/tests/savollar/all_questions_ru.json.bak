                    {
                        "id": 8550,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Запрещается эксплуатация грузового автомобиля (категория N3), если шины имеют остаточную высоту рисунка протектора:"
                            }
                        ],
                        "answers": [
                            {
                                "id": 154129,
                                "newtest_question_id": 8550,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Менее 0,8 мм."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 154130,
                                "newtest_question_id": 8550,
                                "body": [
                                    {
