                    {
                        "id": 8134,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Водитель какого транспортного средства должен уступить дорогу?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8134/8134-1-228.jpg"
                            }
