                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Как правильно снять с пострадавшего рубашку, пиджак при ранении руки?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 147839,
                                "newtest_question_id": 8845,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Одежду начинать снимать с больной руки, затем освобождать здоровую руку."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 147840,
