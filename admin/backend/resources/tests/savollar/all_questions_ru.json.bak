                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Транспортное средство, длина которого с грузом или без груза более 20 м."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 183168,
                                "newtest_question_id": 8517,
