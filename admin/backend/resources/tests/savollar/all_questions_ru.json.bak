                    {
                        "id": 8240,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли в этой обстановке водителю красного автомобиля продолжить движение через пешеходный переход?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8240/8240-1-521.jpg"
                            }
                        ],
                        "answers": [
