                    {
                        "id": 11017,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли выезжать на крайнюю левую полосу, предназначенную для встречного движения на дорогах с двухсторонним движением, имеющим три полосы?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 169610,
                                "newtest_question_id": 11017,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Разрешается для обгона"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 169611,
                                "newtest_question_id": 11017,
                                "body": [
