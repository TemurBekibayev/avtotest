                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Дает ли оранжевый включенный проблесковый маячок оранжевого цвета приоритет в дорожном движении?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6272/6272-1-296.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 187896,
                                "newtest_question_id": 6272,
