                        "id": 10514,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какие из перечисленных транспортных средств разрешается эксплуатировать без огнетушителя?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10514/10514-1.jpg"
                            }
                        ],
                        "answers": [
                            {
