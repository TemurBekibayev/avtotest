                            {
                                "id": 184310,
                                "newtest_question_id": 6382,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Должны уступить дорогу всем транспортным средствам, движущимся по пересекаемой дороге."
                                    }
