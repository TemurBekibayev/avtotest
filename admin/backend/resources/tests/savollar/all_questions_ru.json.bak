                        "id": 8529,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "При какой наименьшей величине падение давления воздуха пневматического или пневмогидравлического тормозного привода за 15 минут при включенных органах управления и неработающем двигателе запрещается эксплуатация транспортного средства?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 154076,
                                "newtest_question_id": 8529,
                                "body": [
