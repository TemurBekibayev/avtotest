                    {
                        "id": 10137,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Вам разрешено продолжить движение на грузовом автомобиле с разрешенной максимальной массой  более 3,5 т:"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10137/10137-1-931.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 189193,
                                "newtest_question_id": 10137,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Только прямо"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 189194,
                                "newtest_question_id": 10137,
                                "body": [
                                    {
                                        "order": 1,
