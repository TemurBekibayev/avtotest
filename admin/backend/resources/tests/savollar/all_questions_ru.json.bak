                        "id": 11196,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какой из указанных знаков используется для обозначения транспортных средств, вынужденно остановившихся в местах с ограниченной видимостью дороги?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11196/11196-1-945.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 173476,
                                "newtest_question_id": 11196,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "А"
                                    }
                                ],
                                "check": 1
                            },
