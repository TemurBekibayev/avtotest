                        "id": 6116,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В случае остановки на подъеме (спуске) при наличии обочины как можно предотвратить самопроизвольное скатывание автомобиля на проезжую часть, повернув его передние колеса в положение?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6116/6116-1-978.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 184624,
                                "newtest_question_id": 6116,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "А и D."
                                    }
                                ],
                                "check": 1
                            },
