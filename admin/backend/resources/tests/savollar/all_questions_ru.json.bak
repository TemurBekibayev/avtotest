                    {
                        "id": 10757,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какое внешнее освещение должно быть включено на буксируемом транспортном средстве?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 168322,
