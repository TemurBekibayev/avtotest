                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "В местах, где расстояние между остановившимися транспортными средствами вдоль сплошной продольной линии составляет менее указанного значения, остановка и стоянка транспортных средств запрещены:"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7579/7579-1-857.jpg"
