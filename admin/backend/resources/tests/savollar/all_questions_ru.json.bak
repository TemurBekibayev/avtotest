                        "id": 11696,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешен ли здесь обгон?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/11696/11696-1-263.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 189880,
                                "newtest_question_id": 11696,
