                    {
                        "id": 6814,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешен ли обгон в этом месте?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6814/6814-1-477.jpg"
                            }
                        ],
                        "answers": [
