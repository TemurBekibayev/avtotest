                    {
                        "id": 10745,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "При движении в темное время суток на не освещенных участках дорог на механическом транспортном средстве должны быть включены:"
                            }
                        ],
                        "answers": [
                            {
                                "id": 172087,
                                "newtest_question_id": 10745,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Ближний или дальний свет фар"
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 172088,
                                "newtest_question_id": 10745,
                                "body": [
