                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли здесь остановка автомобиля?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6601/6601-1-717.jpg"
