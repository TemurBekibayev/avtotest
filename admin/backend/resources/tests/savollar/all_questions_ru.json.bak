                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли водителю автобуса двигатся по полосе, обозначенной этим знаком, если полоса отделена сплошной линией разметки?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10984/10984-1.jpg"
                            }
                        ],
                        "answers": [
