                    {
                        "id": 10077,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Перекресток – это ..."
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10077/10077-1-280.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 164711,
                                "newtest_question_id": 10077,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Территория, непосредственно прилегающая к дороге и не предназначенная для сквозного движения транспортных средств (дворы, жилые массивы, автостоянки, автозаправочные станции, предприятия и т. п.)."
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 164712,
                                "newtest_question_id": 10077,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Место пересечения, примыкания или разветвления дорог на одном уровне."
                                    }
                                ],
                                "check": 1
                            },
                            {
                                "id": 164713,
                                "newtest_question_id": 10077,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Часть дороги, предназначенная для движения безрельсовых транспортных средств."
                                    }
                                ],
                                "check": 0
                            }
                        ],
                        "answer_description": "Согласно статьи 6 Правил дорожного движения, Перекресток — место пересечения, примыкания или разветвления дорог на одном уровне. Границы перекрестка определяются воображаемыми линиями, соединяющими соответственно противоположные, наиболее удаленные от центра перекрестка начала закруглений проезжих частей.\r\nНе считаются перекрестками выезды с прилегающих территорий.",
                        "answer_video": "/test_files/testanswer/newtest_questions/10077/10077.mp4",
                        "comment": null,
                        "static_order_answers": 0,
                        "is_new": false,
