                            {
                                "order": 1,
                                "type": 1,
                                "value": "Когда траспортное средство должно двигаться только по крайней правой полосе?"
                            }
                        ],
                        "answers": [
                            {
                                "id": 168848,
                                "newtest_question_id": 10668,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "При перевозке тяжеловесных  и крупногабаритных грузов"
                                    }
