                        "id": 10260,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Каком рисунке изображен автомобиль, водитель которого нарушает правила перевозки грузов при движении в светлое время суток?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10260/10260-1-962.jpg"
                            }
                        ],
                        "answers": [
