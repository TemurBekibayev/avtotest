                    {
                        "id": 8547,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какой должна быть минимальная остаточная высота рисунка протектора шин транспортных средств категории M1?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8547/8547-1-264.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 183428,
                                "newtest_question_id": 8547,
                                "body": [
