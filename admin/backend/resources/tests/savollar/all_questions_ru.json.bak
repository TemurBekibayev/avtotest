                    {
                        "id": 8884,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Разрешается ли повернуть во двор в этом месте?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/8884/8884-1-183.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 188146,
                                "newtest_question_id": 8884,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Разрешается."
                                    }
                                ],
                                "check": 1
                            },
