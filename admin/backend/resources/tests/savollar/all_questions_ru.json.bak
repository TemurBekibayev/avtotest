                                        "order": 1,
                                        "type": 1,
                                        "value": "Велосипед"
                                    }
                                ],
                                "check": 0
                            },
                            {
                                "id": 189781,
                                "newtest_question_id": 10460,
                                "body": [
                                    {
                                        "order": 1,
