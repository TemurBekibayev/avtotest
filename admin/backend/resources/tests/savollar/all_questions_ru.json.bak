                        "id": 10589,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Когда должна быть прекращена подача сигнала указателями поворота?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/10589/10589-1-639.jpg"
                            }
                        ],
                        "answers": [
                            {
                                "id": 189296,
                                "newtest_question_id": 10589,
                                "body": [
                                    {
                                        "order": 1,
