                            {
                                "order": 1,
                                "type": 1,
                                "value": "Вторым проедет перекресток:"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/7959/7959-1-462.jpg"
                            }
