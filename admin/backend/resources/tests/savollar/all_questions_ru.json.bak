                    {
                        "id": 6476,
                        "lang_id": 2,
                        "body": [
                            {
                                "order": 1,
                                "type": 1,
                                "value": "Какие из указанных знаков разрешают проезд на транспортном средстве к месту проживания или работы?"
                            },
                            {
                                "order": 2,
                                "type": 2,
                                "value": "/test_files/img/newtest_questions/6476/6476-1.png"
                            }
                        ],
                        "answers": [
                            {
                                "id": 152399,
                                "newtest_question_id": 6476,
                                "body": [
                                    {
                                        "order": 1,
                                        "type": 1,
                                        "value": "Только А."
